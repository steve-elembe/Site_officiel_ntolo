# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION OFFICIELLE DU PORTAIL DU VILLAGE DE NTOLO (PRODUCTION)
# ==============================================================================

# URL officielle publique du site (ex: https://ntolo-village.cm)
VITE_SITE_URL="https://ntolo-village.cm"

# Mode Environnement ('production' ou 'development')
VITE_APP_ENV="production"

# ==============================================================================
# PASSERELLES DE PAIEMENT & MOBILE MONEY (OPTIONNELLES)
# ==============================================================================
# Numéros marchands officiels pour souscriptions et dons CODEV
VITE_ORANGE_MONEY_MERCHANT_NUMBER="+237690000000"
VITE_MTN_MOMO_MERCHANT_NUMBER="+237670000000"

# Clés API d'agrégateur CamPay (Cameroun Mobile Money / CB)
VITE_CAMPAY_APP_KEY=""
VITE_CAMPAY_APP_SECRET=""
VITE_CAMPAY_ENVIRONMENT="DEV"

# Clé Publique Flutterwave (CB internationales & transferts diaspora)
VITE_FLUTTERWAVE_PUBLIC_KEY=""
